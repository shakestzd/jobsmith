# Rust build artifacts
/target/

# Tauri-generated capability schemas (regenerated by `tauri-build`)
/gen/schemas/

# Sidecar binaries produced by slice-1's build script
# (e.g. binaries/jobsmith-sidecar-aarch64-apple-darwin)
/binaries/

# The repo-root .gitignore ignores *.png globally. The Tauri bundle icon set
# (referenced by tauri.conf.json -> bundle.icon) MUST be committed or the
# bundle won't build, so re-include the generated icons here.
!icons/*.png
